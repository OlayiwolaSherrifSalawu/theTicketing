{{define "title"}}Create an Account{{end}}

{{define "content"}}
<main class="flex min-h-screen flex-col items-center justify-center px-4 py-12">
  <a href="/" class="mb-8 flex items-center gap-2">
    <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500 text-lg text-white">🎟</span>
    <span class="text-2xl font-bold text-brand-500">theTicketing</span>
  </a>

  <div class="w-full max-w-md rounded-2xl border border-hairline bg-white p-8">
    <h1 class="text-2xl font-bold text-ink">Create an Account</h1>
    <p class="mt-1 text-sm text-ink-soft">Join us to discover and book amazing live events.</p>

    <div id="signup-form-wrapper" class="mt-6">
      {{template "signup_form" .}}
    </div>

    <p class="mt-6 text-center text-sm text-ink-soft">
      Already have an account?
      <a href="/login" class="font-semibold text-brand-500 hover:text-brand-600">Log In</a>
    </p>
  </div>
</main>
{{end}}
