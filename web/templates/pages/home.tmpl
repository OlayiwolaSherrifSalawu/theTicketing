{{define "title"}}Discover unforgettable experiences{{end}}

{{define "content"}}
<nav class="border-b border-hairline bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="text-xl font-bold text-brand-500">theTicketing</a>
    <div class="hidden items-center gap-8 text-sm font-medium text-ink-soft md:flex">
      <a href="/" class="border-b-2 border-brand-500 pb-1 text-ink">Browse Events</a>
      <a href="/venues" class="hover:text-ink">Venues</a>
      <a href="/promoters" class="hover:text-ink">Promoters</a>
    </div>
    <div class="flex items-center gap-3">
      <a href="/login" class="rounded-lg border border-hairline px-4 py-2 text-sm font-semibold text-ink hover:bg-brand-50">Log In</a>
      <a href="/signup" class="rounded-lg bg-brand-500 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-600">Sign Up</a>
    </div>
  </div>
</nav>

<header class="bg-brand-50 px-4 py-16 text-center">
  <h1 class="text-4xl font-bold text-ink">Discover unforgettable experiences</h1>
  <p class="mt-3 text-ink-soft">Find the best events, concerts, and conferences happening near you.</p>

  <form
    hx-get="/events-partial"
    hx-target="#events-grid"
    hx-swap="innerHTML"
    class="mx-auto mt-8 flex max-w-2xl flex-col gap-3 rounded-2xl border border-hairline bg-white p-3 shadow-sm sm:flex-row"
  >
    <input
      type="text" name="eventName" value="{{.Query}}"
      placeholder="What are you looking for?"
      class="flex-1 rounded-lg bg-brand-50 px-4 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:outline-none"
    />
    <input
      type="text" name="location" value="{{.Location}}"
      placeholder="Where?"
      class="flex-1 rounded-lg bg-brand-50 px-4 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:outline-none"
    />
    <button type="submit" class="rounded-lg bg-brand-500 px-6 py-2.5 text-sm font-semibold text-white hover:bg-brand-600">
      Search Events
    </button>
  </form>
</header>

<section class="mx-auto max-w-6xl px-4 pt-8">
  <!-- Decorative only — there's no category column yet, so these don't
       filter anything. Wiring them for real needs a schema change. -->
  <div class="flex flex-wrap gap-2">
    <span class="rounded-full bg-brand-500 px-4 py-2 text-sm font-semibold text-white">All Events</span>
    <span title="Coming soon — no category data yet" class="cursor-not-allowed rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink-faint">Music</span>
    <span title="Coming soon — no category data yet" class="cursor-not-allowed rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink-faint">Sports</span>
    <span title="Coming soon — no category data yet" class="cursor-not-allowed rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink-faint">Tech</span>
    <span title="Coming soon — no category data yet" class="cursor-not-allowed rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink-faint">Arts</span>
    <span title="Coming soon — no category data yet" class="cursor-not-allowed rounded-full border border-hairline px-4 py-2 text-sm font-medium text-ink-faint">Food</span>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-8">
  <h2 class="mb-4 text-xl font-bold text-ink">Upcoming Events</h2>
  <div id="events-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {{template "event_grid" .}}
  </div>
</section>

<footer class="border-t border-hairline bg-brand-50 px-4 py-10">
  <div class="mx-auto max-w-6xl">
    <p class="text-lg font-bold text-brand-500">theTicketing</p>
    <p class="mt-2 text-sm text-ink-soft">© {{.Year}} theTicketing. All rights reserved.</p>
  </div>
</footer>
{{end}}
