# Copy to config.env (git-ignored) and fill in. Real environment
# variables take precedence over this file.

# Postgres connection
Host=localhost
Port=5433
User=ola
Password=change-me
Database=theticketing
# disable | allow | prefer (default) | require | verify-ca | verify-full
SSLMode=prefer

# HS256 signing key for login tokens: at least 32 random bytes,
# e.g. `openssl rand -base64 48`. The server refuses to start without it.
JWT=

# Set to false only if your browser rejects Secure cookies on plain-http
# localhost (older Safari). Leave unset in production.
CookieSecure=
